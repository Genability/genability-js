{
  "name": "@genability/api",
  "version": "3.2.5",
  "description": "Node.js and Browser Javascript SDK for Genability APIs.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Genability/genability-js.git"
  },
  "author": "Genability",
  "license": "MIT",
  "scripts": {
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "precompile": "del-cli dist -f",
    "compile": "tsc -p .",
    "compile:watch": "npx tsc -w",
    "build": "yarn lint && yarn compile && yarn webpack",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "prepublishOnly": "yarn build"
  },
  "devDependencies": {
    "@babel/core": "^7.24.3",
    "@babel/preset-env": "^7.24.3",
    "@babel/preset-typescript": "^7.24.1",
    "@types/jest": "^25.2.1",
    "@types/lodash.clonedeep": "^4.5.6",
    "@types/mock-fs": "^4.10.0",
    "@types/node": "^13.13.1",
    "@typescript-eslint/eslint-plugin": "^2.29.0",
    "@typescript-eslint/parser": "^2.29.0",
    "babel-jest": "^29.7.0",
    "del-cli": "^3.0.0",
    "eslint": "^6.7.0",
    "eslint-config-prettier": "^6.10.1",
    "eslint-import-resolver-typescript": "^2.0.0",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-json": "^2.1.1",
    "eslint-plugin-prettier": "^3.1.3",
    "jest": "^25.4.0",
    "mock-fs": "^4.12.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "prettier": "^2.0.4",
    "ts-jest": "^25.4.0",
    "ts-loader": "^9.5.1",
    "typescript": "^4.0.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "axios": "^1.0.0",
    "graphql": "^16.2.0",
    "graphql-tag": "^2.12.6",
    "lodash.clonedeep": "^4.5.0"
  },
  "bugs": {
    "url": "https://github.com/Genability/genability-js/issues"
  },
  "homepage": "https://github.com/Genability/genability-js#readme",
  "jest": {
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/coverage",
      "<rootDir>/dist"
    ]
  }
}
